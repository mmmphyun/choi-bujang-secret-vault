# Supabase 인증 및 데이터베이스 연결 설정 (비밀값 커밋 금지)
# 새 환경에서는 이 파일을 .env.local 로 복사한 뒤 실제 프로젝트 키를 입력합니다.

# Supabase 프로젝트 HTTPS URL (필수: 로그인, 메모 조회, 복구 영속화)
# 예: https://lokymnrpfrnfirmhjvht.supabase.co
SUPABASE_URL=https://<your-supabase-project-id>.supabase.co

# Supabase Anon 공개 키 (필수: api/auth.js 로그인 프록시용)
SUPABASE_ANON_KEY=eyJ...

# Supabase Service Role 또는 Secret 키 (필수: api/_auth.js JWT 서명 검증 및 REST 통신용)
# 주의: 브라우저에 노출되지 않도록 서버 환경에만 주입합니다.
SUPABASE_SECRET_KEY=eyJ...

# 수업용 AI 게이트웨이 주소 (선택: 미지정 시 기본 심판 주소 사용)
AI_GATEWAY_URL=https://aleph-judge-production.up.railway.app/defense/ai

# 수업용 AI 게이트웨이 인증 토큰 (선택: 인가된 접근 필요 시 입력)
AI_GATEWAY_TOKEN=
